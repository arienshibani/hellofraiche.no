00000Z\"},{\"price\":59.9,\"date\":\"2025-11-18T08:19:14.000000Z\"},{\"price\":59.9,\"date\":\"2025-11-17T08:19:53.000000Z\"},{\"price\":59.9,\"date\":\"2025-11-16T08:18:45.000000Z\"}],\"kassalapp\":{\"url\":\"https://kassal.app/vare/217508-eplecider-eddik-500ml-il-torrione-8014347111369\",\"opengraph\":\"https://kassal.app/opengraph/products/217508.jpg\"},\"created_at\":\"2025-07-02T07:12:22.000000Z\",\"updated_at\":\"2026-01-06T08:24:22.000000Z\"}],\"allergens\":[{\"code\":\"sulfitt\",\"display_name\":\"Sulfitt\",\"contains\":\"YES\"},{\"code\":\"blotdyr\",\"display_name\":\"Bløtdyr\",\"contains\":\"NO\"},{\"code\":\"egg\",\"display_name\":\"Egg\",\"contains\":\"NO\"},{\"code\":\"fisk\",\"display_name\":\"Fisk\",\"contains\":\"NO\"},{\"code\":\"gluten\",\"display_name\":\"Gluten\",\"contains\":\"NO\"},{\"code\":\"lupiner\",\"display_name\":\"Lupiner\",\"contains\":\"NO\"},{\"code\":\"melk\",\"display_name\":\"Melk\",\"contains\":\"NO\"},{\"code\":\"notter\",\"display_name\":\"Nøtter\",\"contains\":\"NO\"},{\"code\":\"peanotter\",\"display_name\":\"Peanøtter\",\"contains\":\"NO\"},{\"code\":\"selleri\",\"display_name\":\"Selleri\",\"contains\":\"NO\"},{\"code\":\"sennep\",\"display_name\":\"Sennep\",\"contains\":\"NO\"},{\"code\":\"sesam\",\"display_name\":\"Sesam\",\"contains\":\"NO\"},{\"code\":\"skalldyr\",\"display_name\":\"Skalldyr\",\"contains\":\"NO\"},{\"code\":\"soya\",\"display_name\":\"Soya\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":18,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":78,\"unit\":\"kj\"},{\"code\":\"enumettet_fett\",\"display_name\":\"Enumettet fett\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"flerumettet_fett\",\"display_name\":\"Flerumettet fett\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"kostfiber\",\"display_name\":\"Kostfiber\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"polyoler\",\"display_name\":\"Sukkeralkoholer\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":0.3,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"stivelse\",\"display_name\":\"Stivelse\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":0,\"unit\":\"g\"}],\"labels\":[{\"name\":\"vegan\",\"display_name\":\"Vegansk\",\"description\":\"Produktet er vegansk\",\"organization\":\"Kassalapp\",\"alternative_names\":null,\"type\":\"Kassalapp\",\"year_established\":2023,\"about\":\"<div>Dette merket, som brukes på Kassalapp nettsiden, fungerer som en indikasjon på at produktet er vegansk. Blad-ikonet ble valgt fordi det er semi-offisielt brukt i ulike veganske organisasjoner, men det finnes ingen fast standard. Derfor har jeg laget mitt eget merke.</div>\",\"note\":\"Ikke en offisiel merkeordning\",\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Vegan.svg\",\"png\":\"https://kassal.app/labels/png/Vegan.png\"}},{\"name\":\"e_merket\",\"display_name\":\"e-merket\",\"description\":\"E-merket er en valgfri merkeordning for ferdigpakninger i EU/EØS-land, som sikrer korrekt nettoinnhold. Det gir forbrukerne trygghet og tillit til produktene de kjøper.\",\"organization\":null,\"alternative_names\":null,\"type\":null,\"year_established\":2008,\"about\":\"<div>℮-tegnet, også kjent som e-merket eller e-symbolet, er en valgfri merkeordning for ferdigpakninger som eksporteres mellom EU/EØS-land, inkludert Norge. Regelverket for e-merket er basert på <a href=\\\"https://eur-lex.europa.eu/legal-content/EN/LSU/?uri=celex:31976L0211\\\">EU-direktiv 76/211/EEC</a> og implementeres i Norge gjennom EØS-avtalen og <a href=\\\"https://lovdata.no/dokument/LTI/forskrift/2007-12-21-1730\\\">forskriften om krav til nettoinnhold i ferdigpakninger</a>. ℮-tegnet står for \\\"quantité estimée\\\" (fransk for \\\"antatt mengde\\\").<br><br>Formålet med e-merket er å sikre at ferdigpakninger inneholder minst like mye som angitt på pakken. Merket brukes på produkter fylt til forhåndsbestemte vektklasser eller volum, fra 5 gram/5 ml til 10 kg/10 l. Grenser er fastsatt for tillatt avvik fra oppgitt innhold i hver pakning.<br><br>Bedrifter kan velge å bruke e-merket, men må følge forskriften og melde fra til Justervesenet. Import av e-merkede varer pakket utenfor EU/EØS-området er ulovlig uten godkjenning fra Justervesenet. Ved e-merking i et annet EU-/EØS-land er ikke godkjenning fra Justervesenet nødvendig.<br><br>E-merket er en viktig indikator for forbrukerne, da det garanterer at ferdigpakningene oppfyller kravene til nettoinnhold. Dette sikrer riktig mengde i produktene og forhindrer feilinformasjon. Ved å bruke e-merket viser bedrifter at de leverer kvalitetsprodukter og følger regelverket for nettoinnhold i ferdigpakninger.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/E-Merket.svg\",\"png\":\"https://kassal.app/labels/png/E-Merket.png\"}}]}}","newDataStr":"{\"data\":{\"ean\":\"8014347111369\",\"products\":[{\"id\":212463,\"name\":\"Eplecider Eddik 500ml Il Torrione\",\"vendor\":\"Haugen - gruppen\",\"brand\":\"Il torrione\",\"description\":\"Frisk, lys og naturlig eplecidereddik fra Italia. Praktisk helletut som gjør det enkelt å posjonere. Nydelig smaksetter til dressinger, salater, marinader og sauser.\",\"ingredients\":\"Eplecidereddik. inneholder sulfitter.\",\"url\":\"https://meny.no/Varer/middagstilbehor/eddiker/eddik/eplecider-eddik-8014347111369\",\"image\":\"https://bilder.ngdata.no/8014347111369/meny/large.jpg\",\"category\":[{\"id\":4,\"depth\":-2,\"name\":\"Middagstilbehør\"},{\"id\":611,\"depth\":-1,\"name\":\"Eddiker\"},{\"id\":617,\"depth\":0,\"name\":\"Eddik\"}],\"store\":{\"name\":\"Meny\",