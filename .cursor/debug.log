name":"Melk","contains":"NO"},{"code":"notter","display_name":"Nøtter","contains":"NO"},{"code":"peanotter","display_name":"Peanøtter","contains":"NO"},{"code":"selleri","display_name":"Selleri","contains":"NO"},{"code":"sennep","display_name":"Sennep","contains":"NO"},{"code":"sesam","display_name":"Sesam","contains":"NO"},{"code":"skalldyr","display_name":"Skalldyr","contains":"NO"},{"code":"soya","display_name":"Soya","contains":"NO"},{"code":"sulfitt","display_name":"Sulfitt","contains":"NO"}],"nutrition":[{"code":"energi_kcal","display_name":"Kalorier","amount":351,"unit":"kcal"},{"code":"energi_kj","display_name":"Energi","amount":1448,"unit":"kj"},{"code":"fett_totalt","display_name":"Fett","amount":33.3,"unit":"g"},{"code":"karbohydrater","display_name":"Karbohydrater","amount":0.2,"unit":"g"},{"code":"kostfiber","display_name":"Kostfiber","amount":0.2,"unit":"g"},{"code":"mettet_fett","display_name":"Mettet fett","amount":12.5,"unit":"g"},{"code":"polyoler","display_name":"Sukkeralkoholer","amount":0,"unit":"g"},{"code":"protein","display_name":"Protein","amount":12.4,"unit":"g"},{"code":"salt","display_name":"Salt","amount":2.2,"unit":"g"},{"code":"stivelse","display_name":"Stivelse","amount":0.2,"unit":"g"},{"code":"sukkerarter","display_name":"Sukkerarter","amount":0,"unit":"g"}],"labels":[{"name":"nyt_norge","display_name":"Nyt Norge","description":"Nyt Norge er en merkeordning som gjør det enklere for kunden å velge norske produkter. For å få produktet stemplet med Nyt Norge må råvarene være norske, bonden må følge norsk regelverk samt at maten må være produsert og pakket i Norge.","organization":"Stiftelsen Norsk Mat","alternative_names":null,"type":null,"year_established":2009,"about":"<div>Nyt Norge er en merkeordning som ble etablert av Stiftelsen Norsk Mat i 2009 for å fremme norske matvarer. Hovedmålet med Nyt Norge er å synliggjøre norske produkter og gjøre det enkelt for forbrukerne å velge norske matvarer i butikkene.<br><br></div><div>For å bli merket med \"Nyt Norge\" må matprodusenter oppfylle tre krav. Produktene må bestå av norske råvarer, bøndene må følge norske regler gjennom <a href=\"https://www.ksl.no/no/ksl-standarder/copy_om-ksl\">Kvalitetssystemet i Landbruket</a> (KSL), og produktet må være produsert og pakket i Norge. Noen produkter, som kjøtt, melk og egg, krever 100% norsk opprinnelse, mens sammensatte produkter tillates opptil 25% ikke-norske ingredienser.</div><div><br>Per januar 2020 var det over 4 300 produkter merket med Nyt Norge. Merkeordningen bidrar til å sikre norsk dyrehelse og miljø, da Norge bruker mindre plantevernmidler og er blant de landene i verden som bruker minst antibiotika til husdyr. Norske bønder følger strenge regler som kontrolleres gjennom KSL for å sikre trygg matproduksjon.</div><div><br>Ved å velge mat merket med Nyt Norge, støtter forbrukerne norske arbeidsplasser. Rundt 100 000 mennesker over hele landet er involvert i produksjonen av maten vi spiser. Nyt Norge-merket gjør det enkelt å velge norsk og nyte de gode smakene av norske bær om sommeren, grønnsaker om høsten, tradisjonelle retter som pinnekjøtt og ribbe til jul, og andre norske kvalitetsprodukter.</div><div><br>Nyt Norge fortsetter å jobbe for å fremme norsk matkultur, bærekraft og selvforsyning. Gjennom merkeordningen og informasjonskampanjer oppfordrer de forbrukerne til å ta bevisste valg og støtte norske matvarer. Ved å velge Nyt Norge kan vi alle bidra til å opprettholde og videreføre norske mattradisjoner og verdiskaping i norsk matproduksjon.</div>","note":null,"icon":{"svg":"https://kassal.app/labels/svg/Nyt Norge.svg","png":"https://kassal.app/labels/png/Nyt Norge.png"}}]}}},"upsert":true},"timestamp":1768999542902,"sessionId":"debug-session","runId":"run1","hypothesisId":"A"}
