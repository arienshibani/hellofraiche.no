andler\",\"contains\":\"NO\"},{\"code\":\"paranott\",\"display_name\":\"Paranøtter\",\"contains\":\"NO\"},{\"code\":\"pekannott\",\"display_name\":\"Pekannøtter\",\"contains\":\"NO\"},{\"code\":\"pistasjnott\",\"display_name\":\"Pistasjnøtter\",\"contains\":\"NO\"},{\"code\":\"valnott\",\"display_name\":\"Valnøtter\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":650,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":2650,\"unit\":\"kj\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":58,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":2.6,\"unit\":\"g\"},{\"code\":\"kostfiber\",\"display_name\":\"Kostfiber\",\"amount\":13,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":8.1,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":22,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":0.03,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":0.7,\"unit\":\"g\"}],\"labels\":[{\"name\":\"debio\",\"display_name\":\"Debio\",\"description\":\"Debio-merket er det offisielle norske økologimerket og gir en garanti for at en vare er økologisk dyrket.\",\"organization\":null,\"alternative_names\":null,\"type\":null,\"year_established\":null,\"about\":\"<div>Debio-merket er det offisielle norske merket for økologiske produkter. Det gir en garanti for at varen er dyrket og produsert i samsvar med økologiske prinsipper. Som en privat medlemsorganisasjon, kontrollerer og merker Debio økologisk landbruksproduksjon, foredling, lagring, import og omsetning i Norge. Organisasjonen har utviklet egne regler og standarder som følges for å oppnå Debio-sertifisering.<br><br></div><div>For å bli merket som økologisk av Debio, må produkter gjennomgå inspeksjoner og oppfylle strenge krav hvert år. Debio samarbeider tett med Mattilsynet for å sikre at økologisk produksjon og merking følger forskriftene om økologisk produksjon og merking av økologiske landbruksprodukter. Dette sikrer at forbrukerne kan stole på at Debio-merket indikerer ekte økologiske produkter.<br><br></div><div>Debio-merket er et pålitelig symbol for forbrukere som ønsker å velge økologiske alternativer og støtte en bærekraftig matproduksjon i Norge. Ved å se etter Debio-merket, kan forbrukere enkelt identifisere og kjøpe produkter som er i tråd med deres ønske om å spise økologisk.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Debio.svg\",\"png\":\"https://kassal.app/labels/png/Debio.png\"}},{\"name\":\"vegan\",\"display_name\":\"Vegansk\",\"description\":\"Produktet er vegansk\",\"organization\":\"Kassalapp\",\"alternative_names\":null,\"type\":\"Kassalapp\",\"year_established\":2023,\"about\":\"<div>Dette merket, som brukes på Kassalapp nettsiden, fungerer som en indikasjon på at produktet er vegansk. Blad-ikonet ble valgt fordi det er semi-offisielt brukt i ulike veganske organisasjoner, men det finnes ingen fast standard. Derfor har jeg laget mitt eget merke.</div>\",\"note\":\"Ikke en offisiel merkeordning\",\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Vegan.svg\",\"png\":\"https://kassal.app/labels/png/Vegan.png\"}},{\"name\":\"euroleaf\",\"display_name\":\"EuroLeaf\",\"description\":\"Euroleaf-logoen er et offisielt merke for økologiske produkter som oppfyller EU-standardene for økologisk produksjon og merking.\",\"organization\":\"Den europeiske union (EU)\",\"alternative_names\":null,\"type\":null,\"year_established\":2010,\"about\":null,\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Euroleaf.svg\",\"png\":\"https://kassal.app/labels/png/Euroleaf.png\"}}]}}","dataMatches":true},"timestamp":1769000363998,"sessionId":"debug-session","runId":"run1","hypothesisId":"C"}
