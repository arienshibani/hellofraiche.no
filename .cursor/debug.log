/Rema 1000.svg"},"current_price":{"price":19.6,"unit_price":null,"date":"2023-07-08T13:56:14.000000Z"},"weight":null,"weight_unit":null,"price_history":[{"price":19.6,"date":"2023-07-08T13:56:14.000000Z"}],"kassalapp":{"url":"https://kassal.app/vare/184898-havregryn-lettkok-11k-7044416013141","opengraph":"https://kassal.app/opengraph/products/184898.jpg"},"created_at":"2023-07-08T13:56:14.000000Z","updated_at":"2024-05-06T00:04:48.000000Z"},{"id":188796,"name":"Havregryn Lettkokte 1,1kg Axa","vendor":"LANTMANNEN CEREALIA AS","brand":"Axa","description":null,"ingredients":"Havregryn (100% fullkorn)","url":"","image":"https://api.vetduat.no/api/images/large/7044416013141","category":[{"id":13,"depth":-2,"name":"Pålegg & frokost"},{"id":37,"depth":-1,"name":"Frokostblandinger og musli"},{"id":203,"depth":0,"name":"Havregryn"}],"store":null,"current_price":null,"weight":1.1,"weight_unit":"kg","price_history":[],"kassalapp":{"url":"https://kassal.app/vare/188796-havregryn-lettkokte-11kg-axa-7044416013141","opengraph":"https://kassal.app/opengraph/products/188796.jpg"},"created_at":"2023-08-11T16:35:56.000000Z","updated_at":"2024-05-06T00:08:37.000000Z"}],"allergens":[{"code":"gluten","display_name":"Gluten","contains":"YES"},{"code":"blotdyr","display_name":"Bløtdyr","contains":"NO"},{"code":"egg","display_name":"Egg","contains":"NO"},{"code":"fisk","display_name":"Fisk","contains":"NO"},{"code":"lupiner","display_name":"Lupiner","contains":"NO"},{"code":"melk","display_name":"Melk","contains":"NO"},{"code":"notter","display_name":"Nøtter","contains":"NO"},{"code":"peanotter","display_name":"Peanøtter","contains":"NO"},{"code":"selleri","display_name":"Selleri","contains":"NO"},{"code":"sennep","display_name":"Sennep","contains":"NO"},{"code":"sesam","display_name":"Sesam","contains":"NO"},{"code":"skalldyr","display_name":"Skalldyr","contains":"NO"},{"code":"soya","display_name":"Soya","contains":"NO"},{"code":"sulfitt","display_name":"Sulfitt","contains":"NO"},{"code":"cashewnott","display_name":"Cashewnøtter","contains":"NO"},{"code":"hasselnott","display_name":"Hasselnøtter","contains":"NO"},{"code":"macadamianott","display_name":"Macademiannøtter","contains":"NO"},{"code":"mandel","display_name":"Mandler","contains":"NO"},{"code":"paranott","display_name":"Paranøtter","contains":"NO"},{"code":"pekannott","display_name":"Pekannøtter","contains":"NO"},{"code":"pistasjnott","display_name":"Pistasjnøtter","contains":"NO"},{"code":"valnott","display_name":"Valnøtter","contains":"NO"}],"nutrition":[{"code":"energi_kcal","display_name":"Kalorier","amount":370,"unit":"kcal"},{"code":"energi_kj","display_name":"Energi","amount":1550,"unit":"kj"},{"code":"enumettet_fett","display_name":"Enumettet fett","amount":2.6,"unit":"g"},{"code":"fett_totalt","display_name":"Fett","amount":7.5,"unit":"g"},{"code":"flerumettet_fett","display_name":"Flerumettet fett","amount":2.4,"unit":"g"},{"code":"karbohydrater","display_name":"Karbohydrater","amount":60,"unit":"g"},{"code":"kostfiber","display_name":"Kostfiber","amount":10,"unit":"g"},{"code":"mettet_fett","display_name":"Mettet fett","amount":1.1,"unit":"g"},{"code":"protein","display_name":"Protein","amount":11,"unit":"g"},{"code":"salt","display_name":"Salt","amount":0,"unit":"g"},{"code":"sukkerarter","display_name":"Sukkerarter","amount":1,"unit":"g"}],"labels":[{"name":"nokkelhull","display_name":"Nøkkelhull","description":"Nøkkelhullet er en offentlig merkeordning for matvarer. Merkeordningen skal gjøre det enkelt å velge sunnere matvarer som inneholder mer fiber og fullkorn og mindre fett, sukker og salt. Innenfor hver matvaregruppe er det satt ulike kriterier for innholdet av disse næringsstoffene.","organization":null,"alternative_names":null,"type":null,"year_established":2009,"about":"<div>Nøkkelhullet er en merkeordning opprettet av myndighetene for å hjelpe folk med å ta sunnere valg i matvarene de kjøper. Matvarer merket med Nøkkelhullet inneholder mindre fett, sukker og salt, og mer fiber og fullkorn. Merket gjør det enklere å identifisere sunnere alternativer. Logoens grønne sirkel med hvitt nøkkelhull er kjennetegnet på Nøkkelhullet.<br><br></div><div>Ved å velge Nøkkelhullet-merkede matvarer kan man enkelt gjøre sunnere endringer i kostholdet. Produktene inneholder mer fiber og fullkorn, mindre mettet fett, sukker og salt, og noen kan også ha mer grønnsaker, frukt og bær. Det finnes mange Nøkkelhull-merkede matvarer, og det er ikke nødvendig å gjøre store endringer i kostholdet. Nøkkelhullet er en frivillig merkeordning som er regulert av Helsedirektoratet og Mattilsynet.<br><br></div><div>Nøkkelhullet tildeles matvarer basert på kriterier for innholdet av fett, mettet fett, sukker, salt, fiber og fullkorn innenfor ulike matvaregrupper. Merket omfatter blant annet grønnsaker, frukt, bær, kornprodukter, meieriprodukter, kjøtt, fisk og vegetabilske produkter. Godteri, brus, kaker og kjeks er ikke kvalifisert for Nøkkelhullet. Ordningen er felles for Norge, Sverige, Danmark og Island, og Mattilsynet fører tilsyn for å sikre at merkets regler overholdes.</div>","note":null,"icon":{"svg":"https://kassal.app/labels/svg/Nokkelhull.svg","png":"https://kassal.app/labels/png/Nokkelhull.png"}},{"name":"nyt_norge","display_name":"Nyt Norge","description":"Nyt Norge er en merkeordning som gjør det enklere for kunden å velge norske produkter. For å få produktet stemplet med Nyt Norge må råvarene være norske, bonden må følge norsk regelverk samt at maten må være produsert og pakket i Norge.","organization":"Stiftelsen Norsk Mat","alternative_names":null,"type":null,"year_established":2009,"about":"<div>Nyt Norge er en merkeordning som ble etablert av Stiftelsen Norsk Mat i 2009 for å fremme norske matvarer. Hovedmålet med Nyt Norge er å synliggjøre norske produkter og gjøre det enkelt for forbrukerne å velge norske matvarer i butikkene.<br><br></div><div>For å bli merket med \"Nyt Norge\" må matprodusenter oppfylle tre krav. Produktene må bestå av norske råvarer, bøndene må følge norske regler gjennom <a href=\"https://www.ksl.no/no/ksl-standarder/copy_om-ksl\">Kvalitetssystemet i Landbruket</a> (KSL), og produktet må være produsert og pakket i Norge. Noen produkter, som kjøtt, melk og egg, krever 100% norsk opprinnelse, mens sammensatte produkter tillates opptil 25% ikke-norske ingredienser.</div><div><br>Per januar 2020 var det over 4 300 produkter merket med Nyt Norge. Merkeordningen bidrar til å sikre norsk dyrehelse og miljø, da Norge bruker mindre plantevernmidler og er blant de landene i verden som bruker minst antibiotika til husdyr. Norske bønder følger strenge regler som kontrolleres gjennom KSL for å sikre trygg matproduksjon.</div><div><br>Ved å velge mat merket med Nyt Norge, støtter forbrukerne norske arbeidsplasser. Rundt 100 000 mennesker over hele landet er involvert i produksjonen av maten vi spiser. Nyt Norge-merket gjør det enkelt å velge norsk og nyte de gode smakene av norske bær om sommeren, grønnsaker om høsten, tradisjonelle retter som pinnekjøtt og ribbe til jul, og andre norske kvalitetsprodukter.</div><div><br>Nyt Norge fortsetter å jobbe for å fremme norsk matkultur, bærekraft og selvforsyning. Gjennom merkeordningen og informasjonskampanjer oppfordrer de forbrukerne til å ta bevisste valg og støtte norske matvarer. Ved å velge Nyt Norge kan vi alle bidra til å opprettholde og videreføre norske mattradisjoner og verdiskaping i norsk matproduksjon.</div>","note":null,"icon":{"svg":"https://kassal.app/labels/svg/Nyt Norge.svg","png":"https://kassal.app/labels/png/Nyt Norge.png"}}]}}},"upsert":true},"timestamp":1768999480017,"sessionId":"debug-session","runId":"run1","hypothesisId":"A"}
