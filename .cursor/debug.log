{"price":32.9,"date":"2023-03-09T10:43:38.000000Z"}],"kassalapp":{"url":"https://kassal.app/vare/63214-spekeskinke-familiens-80g-gilde-7037206101654","opengraph":"https://kassal.app/opengraph/products/63214.jpg"},"created_at":"2022-12-11T19:53:30.000000Z","updated_at":"2024-05-05T22:01:17.000000Z"},{"id":93237,"name":"Familiens Spekeskinke 80g","vendor":"NORTURA SA (GILDE)","brand":"Gilde","description":null,"ingredients":"Til 100 gram ferdig vare er anvendt 140 gram kjøtt av svin, salt, konserveringsmiddel E250.","url":"","image":"https://api.vetduat.no/api/images/large/7037206101654","category":[{"id":13,"depth":-2,"name":"Pålegg & frokost"},{"id":238,"depth":-1,"name":"Spekemat"},{"id":240,"depth":0,"name":"Spekeskinker"}],"store":null,"current_price":null,"weight":80,"weight_unit":"g","price_history":[],"kassalapp":{"url":"https://kassal.app/vare/93237-familiens-spekeskinke-80g-7037206101654","opengraph":"https://kassal.app/opengraph/products/93237.jpg"},"created_at":"2023-06-11T00:48:36.000000Z","updated_at":"2024-05-05T22:37:11.000000Z"},{"id":190233,"name":"Familiens Spekeskinke 80g","vendor":"NORTURA SA (GILDE)","brand":"Gilde","description":null,"ingredients":"Til 100 gram ferdig vare er anvendt 140 gram kjøtt av svin, salt, konserveringsmiddel E250.","url":"","image":"https://api.vetduat.no/api/images/large/7037206101654","category":[{"id":13,"depth":-2,"name":"Pålegg & frokost"},{"id":238,"depth":-1,"name":"Spekemat"},{"id":240,"depth":0,"name":"Spekeskinker"}],"store":null,"current_price":null,"weight":80,"weight_unit":"g","price_history":[],"kassalapp":{"url":"https://kassal.app/vare/190233-familiens-spekeskinke-80g-7037206101654","opengraph":"https://kassal.app/opengraph/products/190233.jpg"},"created_at":"2023-08-11T17:27:45.000000Z","updated_at":"2024-05-06T00:10:01.000000Z"}],"allergens":[{"code":"blotdyr","display_name":"Bløtdyr","contains":"NO"},{"code":"egg","display_name":"Egg","contains":"NO"},{"code":"fisk","display_name":"Fisk","contains":"NO"},{"code":"gluten","display_name":"Gluten","contains":"NO"},{"code":"lupiner","display_name":"Lupiner","contains":"NO"},{"code":"melk","display_name":"Melk","contains":"NO"},{"code":"notter","display_name":"Nøtter","contains":"NO"},{"code":"peanotter","display_name":"Peanøtter","contains":"NO"},{"code":"selleri","display_name":"Selleri","contains":"NO"},{"code":"sennep","display_name":"Sennep","contains":"NO"},{"code":"sesam","display_name":"Sesam","contains":"NO"},{"code":"skalldyr","display_name":"Skalldyr","contains":"NO"},{"code":"soya","display_name":"Soya","contains":"NO"},{"code":"sulfitt","display_name":"Sulfitt","contains":"NO"},{"code":"cashewnott","display_name":"Cashewnøtter","contains":"NO"},{"code":"hasselnott","display_name":"Hasselnøtter","contains":"NO"},{"code":"macadamianott","display_name":"Macademiannøtter","contains":"NO"},{"code":"mandel","display_name":"Mandler","contains":"NO"},{"code":"paranott","display_name":"Paranøtter","contains":"NO"},{"code":"pekannott","display_name":"Pekannøtter","contains":"NO"},{"code":"pistasjnott","display_name":"Pistasjnøtter","contains":"NO"},{"code":"valnott","display_name":"Valnøtter","contains":"NO"}],"nutrition":[{"code":"energi_kcal","display_name":"Kalorier","amount":182,"unit":"kcal"},{"code":"energi_kj","display_name":"Energi","amount":765,"unit":"kj"},{"code":"enumettet_fett","display_name":"Enumettet fett","amount":3.6,"unit":"g"},{"code":"fett_totalt","display_name":"Fett","amount":7.8,"unit":"g"},{"code":"flerumettet_fett","display_name":"Flerumettet fett","amount":1.2,"unit":"g"},{"code":"karbohydrater","display_name":"Karbohydrater","amount":0,"unit":"g"},{"code":"mettet_fett","display_name":"Mettet fett","amount":3,"unit":"g"},{"code":"protein","display_name":"Protein","amount":28,"unit":"g"},{"code":"salt","display_name":"Salt","amount":6.5,"unit":"g"},{"code":"sukkerarter","display_name":"Sukkerarter","amount":0,"unit":"g"}],"labels":[{"name":"nyt_norge","display_name":"Nyt Norge","description":"Nyt Norge er en merkeordning som gjør det enklere for kunden å velge norske produkter. For å få produktet stemplet med Nyt Norge må råvarene være norske, bonden må følge norsk regelverk samt at maten må være produsert og pakket i Norge.","organization":"Stiftelsen Norsk Mat","alternative_names":null,"type":null,"year_established":2009,"about":"<div>Nyt Norge er en merkeordning som ble etablert av Stiftelsen Norsk Mat i 2009 for å fremme norske matvarer. Hovedmålet med Nyt Norge er å synliggjøre norske produkter og gjøre det enkelt for forbrukerne å velge norske matvarer i butikkene.<br><br></div><div>For å bli merket med \"Nyt Norge\" må matprodusenter oppfylle tre krav. Produktene må bestå av norske råvarer, bøndene må følge norske regler gjennom <a href=\"https://www.ksl.no/no/ksl-standarder/copy_om-ksl\">Kvalitetssystemet i Landbruket</a> (KSL), og produktet må være produsert og pakket i Norge. Noen produkter, som kjøtt, melk og egg, krever 100% norsk opprinnelse, mens sammensatte produkter tillates opptil 25% ikke-norske ingredienser.</div><div><br>Per januar 2020 var det over 4 300 produkter merket med Nyt Norge. Merkeordningen bidrar til å sikre norsk dyrehelse og miljø, da Norge bruker mindre plantevernmidler og er blant de landene i verden som bruker minst antibiotika til husdyr. Norske bønder følger strenge regler som kontrolleres gjennom KSL for å sikre trygg matproduksjon.</div><div><br>Ved å velge mat merket med Nyt Norge, støtter forbrukerne norske arbeidsplasser. Rundt 100 000 mennesker over hele landet er involvert i produksjonen av maten vi spiser. Nyt Norge-merket gjør det enkelt å velge norsk og nyte de gode smakene av norske bær om sommeren, grønnsaker om høsten, tradisjonelle retter som pinnekjøtt og ribbe til jul, og andre norske kvalitetsprodukter.</div><div><br>Nyt Norge fortsetter å jobbe for å fremme norsk matkultur, bærekraft og selvforsyning. Gjennom merkeordningen og informasjonskampanjer oppfordrer de forbrukerne til å ta bevisste valg og støtte norske matvarer. Ved å velge Nyt Norge kan vi alle bidra til å opprettholde og videreføre norske mattradisjoner og verdiskaping i norsk matproduksjon.</div>","note":null,"icon":{"svg":"https://kassal.app/labels/svg/Nyt Norge.svg","png":"https://kassal.app/labels/png/Nyt Norge.png"}},{"name":"grontpunkt","display_name":"Grønt Punkt","description":"Grønt Punkt-symbolet viser at bedriften tar sitt lovpålagte produsentansvar for emballasjeinnsamling og gjenvinning.","organization":"Grønt Punkt Norge","alternative_names":null,"type":null,"year_established":1994,"about":"<div>Grønt Punkt-symbolet er et symbol knyttet til produsentansvar for emballasje i Norge. Dette symbolet fungerer som et bevis på at en bedrift har oppfylt sitt lovpålagte ansvar gjennom medlemskap i Grønt Punkt Norge. Som et anerkjent symbol representerer det bedriftens engasjement for innsamling og gjenvinning av emballasje, noe som også har en positiv effekt på bedriftens omdømme.<br><br></div><div><br>Grønt Punkt-symbolet er en kvittering som viser at bedriften har tatt sitt miljøansvar ved å være medlem i et godkjent returselskap for emballasje. Det symboliserer bedriftens betaling for innsamling og gjenvinning av emballasje gjennom Grønt Punkt Norge. Dette er en viktig del av det lovpålagte produsentansvaret for emballasje i Norge.<br><br></div><div><br>Ved å vise Grønt Punkt-symbolet demonstrerer bedriften at den tar ansvar for emballasjen sin gjennom hele livssyklusen. Dette inkluderer finansiering av innsamling og gjenvinning, og bidrar dermed til å redusere miljøbelastningen av emballasje. Som et symbol for miljøansvar bidrar Grønt Punkt-symbolet til å styrke bedriftens omdømme og signaliserer at den tar bærekraft på alvor.<br><br></div><div><br>Grønt Punkt Norge forvalter produsentansvarsordningen for returselskapene som tar seg av ulike typer emballasje. Dette symbolet er en anerkjent markør som har vært i bruk siden 1997. Bedrifter som er medlemmer av Grønt Punkt Norge og bruker symbolet, viser at de tar sin del av ansvaret for emballasjen de produserer eller importerer. Dette bidrar til et mer bærekraftig og ressurseffektivt samfunn.</div>","note":null,"icon":{"svg":"https://kassal.app/labels/svg/Gront Punkt.svg","png":"https://kassal.app/labels/png/Gront Punkt.png"}}]}}},"upsert":true},"timestamp":1768999445694,"sessionId":"debug-session","runId":"run1","hypothesisId":"A"}
