allerken.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Glass og gaffel.svg\",\"png\":\"https://kassal.app/labels/png/Glass og gaffel.png\"}}]}}","dataMatches":false},"timestamp":1768999347450,"sessionId":"debug-session","runId":"run1","hypothesisId":"C"}
