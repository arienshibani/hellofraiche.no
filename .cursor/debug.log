],\"allergens\":[{\"code\":\"melk\",\"display_name\":\"Melk\",\"contains\":\"YES\"},{\"code\":\"blotdyr\",\"display_name\":\"Bløtdyr\",\"contains\":\"NO\"},{\"code\":\"egg\",\"display_name\":\"Egg\",\"contains\":\"NO\"},{\"code\":\"fisk\",\"display_name\":\"Fisk\",\"contains\":\"NO\"},{\"code\":\"gluten\",\"display_name\":\"Gluten\",\"contains\":\"NO\"},{\"code\":\"lupiner\",\"display_name\":\"Lupiner\",\"contains\":\"NO\"},{\"code\":\"notter\",\"display_name\":\"Nøtter\",\"contains\":\"NO\"},{\"code\":\"peanotter\",\"display_name\":\"Peanøtter\",\"contains\":\"NO\"},{\"code\":\"selleri\",\"display_name\":\"Selleri\",\"contains\":\"NO\"},{\"code\":\"sennep\",\"display_name\":\"Sennep\",\"contains\":\"NO\"},{\"code\":\"sesam\",\"display_name\":\"Sesam\",\"contains\":\"NO\"},{\"code\":\"skalldyr\",\"display_name\":\"Skalldyr\",\"contains\":\"NO\"},{\"code\":\"soya\",\"display_name\":\"Soya\",\"contains\":\"NO\"},{\"code\":\"sulfitt\",\"display_name\":\"Sulfitt\",\"contains\":\"NO\"},{\"code\":\"cashewnott\",\"display_name\":\"Cashewnøtter\",\"contains\":\"NO\"},{\"code\":\"hasselnott\",\"display_name\":\"Hasselnøtter\",\"contains\":\"NO\"},{\"code\":\"macadamianott\",\"display_name\":\"Macademiannøtter\",\"contains\":\"NO\"},{\"code\":\"mandel\",\"display_name\":\"Mandler\",\"contains\":\"NO\"},{\"code\":\"paranott\",\"display_name\":\"Paranøtter\",\"contains\":\"NO\"},{\"code\":\"pekannott\",\"display_name\":\"Pekannøtter\",\"contains\":\"NO\"},{\"code\":\"pistasjnott\",\"display_name\":\"Pistasjnøtter\",\"contains\":\"NO\"},{\"code\":\"valnott\",\"display_name\":\"Valnøtter\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":252,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":1055,\"unit\":\"kj\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":24,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":2.5,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":16,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":6.6,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":1.3,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":2.5,\"unit\":\"g\"}],\"labels\":[{\"name\":\"grontpunkt\",\"display_name\":\"Grønt Punkt\",\"description\":\"Grønt Punkt-symbolet viser at bedriften tar sitt lovpålagte produsentansvar for emballasjeinnsamling og gjenvinning.\",\"organization\":\"Grønt Punkt Norge\",\"alternative_names\":null,\"type\":null,\"year_established\":1994,\"about\":\"<div>Grønt Punkt-symbolet er et symbol knyttet til produsentansvar for emballasje i Norge. Dette symbolet fungerer som et bevis på at en bedrift har oppfylt sitt lovpålagte ansvar gjennom medlemskap i Grønt Punkt Norge. Som et anerkjent symbol representerer det bedriftens engasjement for innsamling og gjenvinning av emballasje, noe som også har en positiv effekt på bedriftens omdømme.<br><br></div><div><br>Grønt Punkt-symbolet er en kvittering som viser at bedriften har tatt sitt miljøansvar ved å være medlem i et godkjent returselskap for emballasje. Det symboliserer bedriftens betaling for innsamling og gjenvinning av emballasje gjennom Grønt Punkt Norge. Dette er en viktig del av det lovpålagte produsentansvaret for emballasje i Norge.<br><br></div><div><br>Ved å vise Grønt Punkt-symbolet demonstrerer bedriften at den tar ansvar for emballasjen sin gjennom hele livssyklusen. Dette inkluderer finansiering av innsamling og gjenvinning, og bidrar dermed til å redusere miljøbelastningen av emballasje. Som et symbol for miljøansvar bidrar Grønt Punkt-symbolet til å styrke bedriftens omdømme og signaliserer at den tar bærekraft på alvor.<br><br></div><div><br>Grønt Punkt Norge forvalter produsentansvarsordningen for returselskapene som tar seg av ulike typer emballasje. Dette symbolet er en anerkjent markør som har vært i bruk 