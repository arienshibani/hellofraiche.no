"price\":42.4,\"date\":\"2023-03-20T02:57:40.000000Z\"},{\"price\":42.4,\"date\":\"2023-03-18T10:51:25.000000Z\"},{\"price\":42.4,\"date\":\"2023-03-17T10:24:08.000000Z\"},{\"price\":42.4,\"date\":\"2023-03-15T08:52:05.000000Z\"},{\"price\":42.4,\"date\":\"2023-03-13T06:54:15.000000Z\"}],\"kassalapp\":{\"url\":\"https://kassal.app/vare/59271-laksefilet-naturell-4x125g-first-price-7035620087509\",\"opengraph\":\"https://kassal.app/opengraph/products/59271.jpg\"},\"created_at\":\"2022-12-11T19:53:01.000000Z\",\"updated_at\":\"2024-05-05T22:31:59.000000Z\"}],\"allergens\":[{\"code\":\"fisk\",\"display_name\":\"Fisk\",\"contains\":\"YES\"},{\"code\":\"blotdyr\",\"display_name\":\"Bløtdyr\",\"contains\":\"NO\"},{\"code\":\"egg\",\"display_name\":\"Egg\",\"contains\":\"NO\"},{\"code\":\"gluten\",\"display_name\":\"Gluten\",\"contains\":\"NO\"},{\"code\":\"lupiner\",\"display_name\":\"Lupiner\",\"contains\":\"NO\"},{\"code\":\"melk\",\"display_name\":\"Melk\",\"contains\":\"NO\"},{\"code\":\"notter\",\"display_name\":\"Nøtter\",\"contains\":\"NO\"},{\"code\":\"peanotter\",\"display_name\":\"Peanøtter\",\"contains\":\"NO\"},{\"code\":\"selleri\",\"display_name\":\"Selleri\",\"contains\":\"NO\"},{\"code\":\"sennep\",\"display_name\":\"Sennep\",\"contains\":\"NO\"},{\"code\":\"sesam\",\"display_name\":\"Sesam\",\"contains\":\"NO\"},{\"code\":\"skalldyr\",\"display_name\":\"Skalldyr\",\"contains\":\"NO\"},{\"code\":\"soya\",\"display_name\":\"Soya\",\"contains\":\"NO\"},{\"code\":\"sulfitt\",\"display_name\":\"Sulfitt\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":224,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":932,\"unit\":\"kj\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":16,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"kostfiber\",\"display_name\":\"Kostfiber\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":3,\"unit\":\"g\"},{\"code\":\"polyoler\",\"display_name\":\"Sukkeralkoholer\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":20,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":0.1,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":0,\"unit\":\"g\"}],\"labels\":[{\"name\":\"nokkelhull\",\"display_name\":\"Nøkkelhull\",\"description\":\"Nøkkelhullet er en offentlig merkeordning for matvarer. Merkeordningen skal gjøre det enkelt å velge sunnere matvarer som inneholder mer fiber og fullkorn og mindre fett, sukker og salt. Innenfor hver matvaregruppe er det satt ulike kriterier for innholdet av disse næringsstoffene.\",\"organization\":null,\"alternative_names\":null,\"type\":null,\"year_established\":2009,\"about\":\"<div>Nøkkelhullet er en merkeordning opprettet av myndighetene for å hjelpe folk med å ta sunnere valg i matvarene de kjøper. Matvarer merket med Nøkkelhullet inneholder mindre fett, sukker og salt, og mer fiber og fullkorn. Merket gjør det enklere å identifisere sunnere alternativer. Logoens grønne sirkel med hvitt nøkkelhull er kjennetegnet på Nøkkelhullet.<br><br></div><div>Ved å velge Nøkkelhullet-merkede matvarer kan man enkelt gjøre sunnere endringer i kostholdet. Produktene inneholder mer fiber og fullkorn, mindre mettet fett, sukker og salt, og noen kan også ha mer grønnsaker, frukt og bær. Det finnes mange Nøkkelhull-merkede matvarer, og det er ikke nødvendig å gjøre store endringer i kostholdet. Nøkkelhullet er en frivillig merkeordning som er regulert av Helsedirektoratet og Mattilsynet.<br><br></div><div>Nøkkelhullet tildeles matvarer basert på kriterier for innholdet av fett, mettet fett, sukker, salt, fiber og fullkorn innenfor ulike matvaregrupper. Merket omfatter blant annet grønnsaker, frukt, bær, kornprodukter, meieriprodukter, kjøtt, fisk og vegetabilske produkter. Godteri, brus, kaker og kjeks er ikke kvalifisert for Nøkkelhullet. Ordningen er felles for Norge, Sverige, Danmark og Island, og Mattilsynet fører tilsyn for å sikre at merkets regler overholdes.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Nokkelhull.svg\",\"png\":\"https://kassal.app/labels/png/Nokkelhull.png\"}},{\"name\":\"frysevare\",\"display_name\":\"Frysevare\",\"description\":\"Produktet er en frysevare.\",\"organization\":\"Kassalapp\",\"alternative_names\":null,\"type\":\"Kassalapp\",\"year_established\":2023,\"about\":\"<div>Dette merket, som brukes på Kassalapp nettsiden, viser at produktet er en frysevare.&nbsp;<br><br>Snøfnugg-ikonet ble valgt fordi det assosieres med kulde og frysing, og det gir tydelig informasjon til forbrukerne.</div>\",\"note\":\"Ikke en offisiel merkeordning\",\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Frysevare.svg\",\"png\":\"https://kassal.app/labels/png/Frysevare.png\"}}]}}","dataMatches":true},"timestamp":1769000529865,"sessionId":"debug-session","runId":"run1","hypothesisId":"C"}
