-12-22T08:00:24.000000Z\"},{\"price\":99,\"date\":\"2025-12-21T08:00:21.000000Z\"},{\"price\":99,\"date\":\"2025-12-19T08:00:25.000000Z\"},{\"price\":99,\"date\":\"2025-12-17T08:00:20.000000Z\"},{\"price\":99,\"date\":\"2025-12-16T08:00:23.000000Z\"},{\"price\":99,\"date\":\"2025-12-15T08:00:23.000000Z\"},{\"price\":99,\"date\":\"2025-12-12T08:00:19.000000Z\"}],\"kassalapp\":{\"url\":\"https://kassal.app/vare/20000-storfe-angus-biffstrimler-300g-meny-7020098000686\",\"opengraph\":\"https://kassal.app/opengraph/products/20000.jpg\"},\"created_at\":\"2022-01-09T18:55:53.000000Z\",\"updated_at\":\"2026-01-20T08:00:15.000000Z\"}],\"allergens\":[{\"code\":\"blotdyr\",\"display_name\":\"Bløtdyr\",\"contains\":\"NO\"},{\"code\":\"egg\",\"display_name\":\"Egg\",\"contains\":\"NO\"},{\"code\":\"fisk\",\"display_name\":\"Fisk\",\"contains\":\"NO\"},{\"code\":\"gluten\",\"display_name\":\"Gluten\",\"contains\":\"NO\"},{\"code\":\"lupiner\",\"display_name\":\"Lupiner\",\"contains\":\"NO\"},{\"code\":\"melk\",\"display_name\":\"Melk\",\"contains\":\"NO\"},{\"code\":\"notter\",\"display_name\":\"Nøtter\",\"contains\":\"NO\"},{\"code\":\"peanotter\",\"display_name\":\"Peanøtter\",\"contains\":\"NO\"},{\"code\":\"selleri\",\"display_name\":\"Selleri\",\"contains\":\"NO\"},{\"code\":\"sennep\",\"display_name\":\"Sennep\",\"contains\":\"NO\"},{\"code\":\"sesam\",\"display_name\":\"Sesam\",\"contains\":\"NO\"},{\"code\":\"skalldyr\",\"display_name\":\"Skalldyr\",\"contains\":\"NO\"},{\"code\":\"soya\",\"display_name\":\"Soya\",\"contains\":\"NO\"},{\"code\":\"sulfitt\",\"display_name\":\"Sulfitt\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":105,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":445,\"unit\":\"kj\"},{\"code\":\"enumettet_fett\",\"display_name\":\"Enumettet fett\",\"amount\":0.6,\"unit\":\"g\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":1.7,\"unit\":\"g\"},{\"code\":\"flerumettet_fett\",\"display_name\":\"Flerumettet fett\",\"amount\":0.1,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":0.8,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":23,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":0.1,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":0,\"unit\":\"g\"}],\"labels\":[{\"name\":\"nokkelhull\",\"display_name\":\"Nøkkelhull\",\"description\":\"Nøkkelhullet er en offentlig merkeordning for matvarer. Merkeordningen skal gjøre det enkelt å velge sunnere matvarer som inneholder mer fiber og fullkorn og mindre fett, sukker og salt. Innenfor hver matvaregruppe er det satt ulike kriterier for innholdet av disse næringsstoffene.\",\"organization\":null,\"alternative_names\":null,\"type\":null,\"year_established\":2009,\"about\":\"<div>Nøkkelhullet er en merkeordning opprettet av myndighetene for å hjelpe folk med å ta sunnere valg i matvarene de kjøper. Matvarer merket med Nøkkelhullet inneholder mindre fett, sukker og salt, og mer fiber og fullkorn. Merket gjør det enklere å identifisere sunnere alternativer. Logoens grønne sirkel med hvitt nøkkelhull er kjennetegnet på Nøkkelhullet.<br><br></div><div>Ved å velge Nøkkelhullet-merkede matvarer kan man enkelt gjøre sunnere endringer i kostholdet. Produktene inneholder mer fiber og fullkorn, mindre mettet fett, sukker og salt, og noen kan også ha mer grønnsaker, frukt og bær. Det finnes mange Nøkkelhull-merkede matvarer, og det er ikke nødvendig å gjøre store endringer i kostholdet. Nøkkelhullet er en frivillig merkeordning som er regulert av Helsedirektoratet og Mattilsynet.<br><br></div><div>Nøkkelhullet tildeles matvarer basert på kriterier for innholdet av fett, mettet fett, sukker, salt, fiber og fullkorn innenfor ulike matvaregrupper. Merket omfatter blant annet grønnsaker, frukt, bær, kornprodukter, meieriprodukter, kjøtt, fisk og vegetabilske produkter. Godteri, brus, kaker og kjeks er ikke kvalifisert for Nøkkelhullet. Ordningen er felles for Norge, Sverige, Danmark og Island, og Mattilsynet fører tilsyn for å sikre at merkets regler overholdes.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Nokkelhull.svg\",\"png\":\"https://kassal.app/labels/png/Nokkelhull.png\"}},{\"name\":\"nyt_norge\",\"display_name\":\"Nyt Norge\",\"description\":\"Nyt Norge er en merkeordning som gjør det enklere for kunden å velge norske produkter. For å få produktet stemplet med Nyt Norge må råvarene være norske, bonden må følge norsk regelverk samt at maten må være produsert og pakket i Norge.\",\"organization\":\"Stiftelsen Norsk Mat\",\"alternative_names\":null,\"type\":null,\"year_established\":2009,\"about\":\"<div>Nyt Norge er en merkeordning som ble etablert av Stiftelsen Norsk Mat i 2009 for å fremme norske matvarer. Hovedmålet med Nyt Norge er å synliggjøre norske produkter og gjøre det enkelt for forbrukerne å velge norske matvarer i butikkene.<br><br></div><div>For å bli merket med \\\"Nyt Norge\\\" må matprodusenter oppfylle tre krav. Produktene må bestå av norske råvarer, bøndene må følge norske regler gjennom <a href=\\\"https://www.ksl.no/no/ksl-standarder/copy_om-ksl\\\">Kvalitetssystemet i Landbruket</a> (KSL), og produktet må være produsert og pakket i Norge. Noen produkter, som kjøtt, melk og egg, krever 100% norsk opprinnelse, mens sammensatte produkter tillates opptil 25% ikke-norske ingredienser.</div><div><br>Per januar 2020 var det over 4 300 produkter merket med Nyt Norge. Merkeordningen bidrar til å sikre norsk dyrehelse og miljø, da Norge bruker mindre plantevernmidler og er blant de landene i verden som bruker minst antibiotika til husdyr. Norske bønder følger strenge regler som kontrolleres gjennom KSL for å sikre trygg matproduksjon.</div><div><br>Ved å velge mat merket med Nyt Norge, støtter forbrukerne norske arbeidsplasser. Rundt 100 000 mennesker over hele landet er involvert i produksjonen av maten vi spiser. Nyt Norge-merket gjør det enkelt å velge norsk og nyte de gode smakene av norske bær om sommeren, grønnsaker om høsten, tradisjonelle retter som pinnekjøtt og ribbe til jul, og andre norske kvalitetsprodukter.</div><div><br>Nyt Norge fortsetter å jobbe for å fremme norsk matkultur, bærekraft og selvforsyning. Gjennom merkeordningen og informasjonskampanjer oppfordrer de forbrukerne til å ta bevisste valg og støtte norske matvarer. Ved å velge Nyt Norge kan vi alle bidra til å opprettholde og videreføre norske mattradisjoner og verdiskaping i norsk matproduksjon.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Nyt Norge.svg\",\"png\":\"https://kassal.app/labels/png/Nyt Norge.png\"}},{\"name\":\"matskatt\",\"display_name\":\"Matskatt\",\"description\":\"Matskatter er norske produkter med unik kvalitet, i kombinasjon med klar lokal identitet og en god historie. Fordi lokalmat er viktig for deg, er stort utvalg norske matskatter viktig for oss.\",\"organization\":\"MENY\",\"alternative_names\":null,\"type\":null,\"year_established\":null,\"about\":\"<div>Matskatt er en merkeordning fra <a href=\\\"https://kassal.app/kjeder/meny\\\">MENY</a> som omfavner lokal mat, regional mat, kortreist mat og gårdsmat under ett felles begrep. Matskatter er mat- og drikkeprodukter som utmerker seg med en ekstra god smak, unik kvalitet og en spesiell historie. Disse produktene er preget av klar lokal identitet og kommer ofte fra både små og store produsenter.<br><br></div><div>En Matskatt defineres av sin unike kvalitet, tydelig lokal identitet og en god historie. Det kan være alt fra en utmerket ost, en smakfull skinke, et nydelig syltetøy, delikat klippfisk, en renskåret lakseloin, gode pølser, gårdspresset eple eller en velsmakende potet. MENY har funnet over 4500 produkter fra rundt 450 lokale produsenter som passer inn i Matskatt-kategorien.<br><br></div><div>MENY-Lauget, som består av erfarne fagpersoner fra ulike områder som kokker, slaktere, pølsemakere og fiskehandlere, er ansvarlig for å oppdage og promotere Matskattene. De følger med på produktutviklingen i sin region og jakter kontinuerlig på nye Matskatter. Du kan se etter Matskatt-merket i MENY-butikkene og nettbutikken for å finne disse spesielle produktene.<br><br></div><div>Matskattene er viktige for kundene til MENY, og det er en del av deres innsats for å ivareta norske mattradisjoner og støtte visjonære produsenter. MENY deler også ut Matskattstipendet årlig, som gir produsenter muligheten til å utforske nye produkter, øke produksjonen eller realisere innovasjonsprosjekter. Produsentene som bidrar til mangfoldet og skaper de uunnværlige smakene i norske Matskatter blir verdsatt og anerkjent.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Matskatt.svg\",\"png\":\"https://kassal.app/labels/png/Matskatt.png\"}}]}","newDataStr":"{\"data\":{\"ean\":\"7020098000686\",\"products\":[{\"id\":20000,\"name\":\"Storfe Angus Biffstrimler 300g Meny\",\"vendor\":\"Norfersk\",\"brand\":\"Meny\",\"description\":\".\",\"ingredients\":\"Storfekjøtt\",\"url\":\"https://meny.no/Varer/kjott/storfekjott/biffstrimler/storfe-angus-7020098000686\",\"image\":\"https://bilder.ngdata.no/7020098000686/meny/large.jpg\",\"category\":[{\"id\":43,\"depth\":-2,\"name\":\"Kjøtt\"},{\"id\":392,\"depth\":-1,\"name\":\"Storfekjøtt\"},{\"id\":393,\"depth\":0,\"name\":\"Biffstrimler\"}],\"store\":{\"name\":\"Meny\",\"code\":\"MENY_NO\",\"url\":\"https://meny.no/Varer\",\"logo\":\"https://kassal.app/logos/Meny.svg\"},\"current_price\":{\"price\":99,\"unit_price\":330,\"date\":\"2026-01-21T08:00:12.000000Z\"},\"weight\":300,\"weight_unit\":\"g\",\"price_history\":[{\"price\":99,\"date\":\"2026-01-21T08:00:12.000000Z\"},{\"price\":99,\"date\":\"2026-01-20T08:00:15.000000Z\"},{\"price\":99,\"date\":\"2026-01-19T08:00:20.000000Z\"},{\"price\":99,\"date\":\"2026-01-18T08:00:17.000000Z\"},{\"price\":99,\"date\":\"2026-01-14T08:00:18.000000Z\"},{\"price\":99,\"date\":\"2026-01-11T08:00:15.000000Z\"},{\"price\":99,\"date\":\"2026-01-10T08:00:21.000000Z\"},{\"price\":101,\"date\":\"2026-01-06T08:00:13.000000Z\"},{\"price\":101,\"date\":\"2026-01-05T08:00:21.000000Z\"},{\"price\":101,\"date\":\"2026-01-04T08:00:21.000000Z\"},{\"price\":101,\"date\":\"2026-01-03T08:00:21.000000Z\"},{\"price\":101,\"date\":\"2026-01-02T08:00:20.000000Z\"},{\"price\":101,\"date\":\"2026-01-01T08:00:16.000000Z\"},{\"price\":99,\"date\":\"2025-12-31T08:00:21.000000Z\"},{\"price\":99,\"date\":\"2025-12-30T08:00:21.000000Z\"},{\"price\":99,\"date\":\"2025-12-28T08:00:23.000000Z\"},{\"price\":99,\"date\":\"2025-12-26T08:00:16.000000Z\"},{\"price\":99,\"date\":\"2025-12-25T08:00:29.000000Z\"},{\"price\":99,\"date\":\"2025-12-24T08:00:21.000000Z\"},{\"price\":99,\"date\":\"2025-12-22T08:00:24.000000Z\"},{\"price\":99,\"date\":\"2025-12-21T08:00:21.000000Z\"},{\"price\":99,\"date\":\"2025-12-19T08:00:25.000000Z\"},{\"price\":99,\"date\":\"2025-12-17T08:00:20.000000Z\"},{\"price\":99,\"date\":\"2025-12-16T08:00:23.000000Z\"},{\"price\":99,\"date\":\"2025-12-15T08:00:23.000000Z\"}],\"kassalapp\":{\"url\":\"https://kassal.app/vare/20000-storfe-angus-biffstrimler-300g-meny-7020098000686\",\"opengraph\":\"https://kassal.app/opengraph/products/20000.jpg\"},\"created_at\":\"2022-01-09T18:55:53.000000Z\",\"updated_at\":\"2026-01-21T08:00:12.000000Z\"}],\"allergens\":[{\"code\":\"blotdyr\",\"display_name\":\"Bløtdyr\",\"contains\":\"NO\"},{\"code\":\"egg\",\"display_name\":\"Egg\",\"contains\":\"NO\"},{\"code\":\"fisk\",\"display_name\":\"Fisk\",\"contains\":\"NO\"},{\"code\":\"gluten\",\"display_name\":\"Gluten\",\"contains\":\"NO\"},{\"code\":\"lupiner\",\"display_name\":\"Lupiner\",\"contains\":\"NO\"},{\"code\":\"melk\",\"display_name\":\"Melk\",\"contains\":\"NO\"},{\"code\":\"notter\",\"display_name\":\"Nøtter\",\"contains\":\"NO\"},{\"code\":\"peanotter\",\"display_name\":\"Peanøtter\",\"contains\":\"NO\"},{\"code\":\"selleri\",\"display_name\":\"Selleri\",\"contains\":\"NO\"},{\"code\":\"sennep\",\"display_name\":\"Sennep\",\"contains\":\"NO\"},{\"code\":\"sesam\",\"display_name\":\"Sesam\",\"contains\":\"NO\"},{\"code\":\"skalldyr\",\"display_name\":\"Skalldyr\",\"contains\":\"NO\"},{\"code\":\"soya\",\"display_name\":\"Soya\",\"contains\":\"NO\"},{\"code\":\"sulfitt\",\"display_name\":\"Sulfitt\",\"contains\":\"NO\"}],\"nutrition\":[{\"code\":\"energi_kcal\",\"display_name\":\"Kalorier\",\"amount\":105,\"unit\":\"kcal\"},{\"code\":\"energi_kj\",\"display_name\":\"Energi\",\"amount\":445,\"unit\":\"kj\"},{\"code\":\"enumettet_fett\",\"display_name\":\"Enumettet fett\",\"amount\":0.6,\"unit\":\"g\"},{\"code\":\"fett_totalt\",\"display_name\":\"Fett\",\"amount\":1.7,\"unit\":\"g\"},{\"code\":\"flerumettet_fett\",\"display_name\":\"Flerumettet fett\",\"amount\":0.1,\"unit\":\"g\"},{\"code\":\"karbohydrater\",\"display_name\":\"Karbohydrater\",\"amount\":0,\"unit\":\"g\"},{\"code\":\"mettet_fett\",\"display_name\":\"Mettet fett\",\"amount\":0.8,\"unit\":\"g\"},{\"code\":\"protein\",\"display_name\":\"Protein\",\"amount\":23,\"unit\":\"g\"},{\"code\":\"salt\",\"display_name\":\"Salt\",\"amount\":0.1,\"unit\":\"g\"},{\"code\":\"sukkerarter\",\"display_name\":\"Sukkerarter\",\"amount\":0,\"unit\":\"g\"}],\"labels\":[{\"name\":\"nokkelhull\",\"display_name\":\"Nøkkelhull\",\"description\":\"Nøkkelhullet er en offentlig merkeordning for matvarer. Merkeordningen skal gjøre det enkelt å velge sunnere matvarer som inneholder mer fiber og fullkorn og mindre fett, sukker og salt. Innenfor hver matvaregruppe er det satt ulike kriterier for innholdet av disse næringsstoffene.\",\"organization\":null,\"alternative_names\":null,\"type\":null,\"year_established\":2009,\"about\":\"<div>Nøkkelhullet er en merkeordning opprettet av myndighetene for å hjelpe folk med å ta sunnere valg i matvarene de kjøper. Matvarer merket med Nøkkelhullet inneholder mindre fett, sukker og salt, og mer fiber og fullkorn. Merket gjør det enklere å identifisere sunnere alternativer. Logoens grønne sirkel med hvitt nøkkelhull er kjennetegnet på Nøkkelhullet.<br><br></div><div>Ved å velge Nøkkelhullet-merkede matvarer kan man enkelt gjøre sunnere endringer i kostholdet. Produktene inneholder mer fiber og fullkorn, mindre mettet fett, sukker og salt, og noen kan også ha mer grønnsaker, frukt og bær. Det finnes mange Nøkkelhull-merkede matvarer, og det er ikke nødvendig å gjøre store endringer i kostholdet. Nøkkelhullet er en frivillig merkeordning som er regulert av Helsedirektoratet og Mattilsynet.<br><br></div><div>Nøkkelhullet tildeles matvarer basert på kriterier for innholdet av fett, mettet fett, sukker, salt, fiber og fullkorn innenfor ulike matvaregrupper. Merket omfatter blant annet grønnsaker, frukt, bær, kornprodukter, meieriprodukter, kjøtt, fisk og vegetabilske produkter. Godteri, brus, kaker og kjeks er ikke kvalifisert for Nøkkelhullet. Ordningen er felles for Norge, Sverige, Danmark og Island, og Mattilsynet fører tilsyn for å sikre at merkets regler overholdes.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Nokkelhull.svg\",\"png\":\"https://kassal.app/labels/png/Nokkelhull.png\"}},{\"name\":\"nyt_norge\",\"display_name\":\"Nyt Norge\",\"description\":\"Nyt Norge er en merkeordning som gjør det enklere for kunden å velge norske produkter. For å få produktet stemplet med Nyt Norge må råvarene være norske, bonden må følge norsk regelverk samt at maten må være produsert og pakket i Norge.\",\"organization\":\"Stiftelsen Norsk Mat\",\"alternative_names\":null,\"type\":null,\"year_established\":2009,\"about\":\"<div>Nyt Norge er en merkeordning som ble etablert av Stiftelsen Norsk Mat i 2009 for å fremme norske matvarer. Hovedmålet med Nyt Norge er å synliggjøre norske produkter og gjøre det enkelt for forbrukerne å velge norske matvarer i butikkene.<br><br></div><div>For å bli merket med \\\"Nyt Norge\\\" må matprodusenter oppfylle tre krav. Produktene må bestå av norske råvarer, bøndene må følge norske regler gjennom <a href=\\\"https://www.ksl.no/no/ksl-standarder/copy_om-ksl\\\">Kvalitetssystemet i Landbruket</a> (KSL), og produktet må være produsert og pakket i Norge. Noen produkter, som kjøtt, melk og egg, krever 100% norsk opprinnelse, mens sammensatte produkter tillates opptil 25% ikke-norske ingredienser.</div><div><br>Per januar 2020 var det over 4 300 produkter merket med Nyt Norge. Merkeordningen bidrar til å sikre norsk dyrehelse og miljø, da Norge bruker mindre plantevernmidler og er blant de landene i verden som bruker minst antibiotika til husdyr. Norske bønder følger strenge regler som kontrolleres gjennom KSL for å sikre trygg matproduksjon.</div><div><br>Ved å velge mat merket med Nyt Norge, støtter forbrukerne norske arbeidsplasser. Rundt 100 000 mennesker over hele landet er involvert i produksjonen av maten vi spiser. Nyt Norge-merket gjør det enkelt å velge norsk og nyte de gode smakene av norske bær om sommeren, grønnsaker om høsten, tradisjonelle retter som pinnekjøtt og ribbe til jul, og andre norske kvalitetsprodukter.</div><div><br>Nyt Norge fortsetter å jobbe for å fremme norsk matkultur, bærekraft og selvforsyning. Gjennom merkeordningen og informasjonskampanjer oppfordrer de forbrukerne til å ta bevisste valg og støtte norske matvarer. Ved å velge Nyt Norge kan vi alle bidra til å opprettholde og videreføre norske mattradisjoner og verdiskaping i norsk matproduksjon.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Nyt Norge.svg\",\"png\":\"https://kassal.app/labels/png/Nyt Norge.png\"}},{\"name\":\"matskatt\",\"display_name\":\"Matskatt\",\"description\":\"Matskatter er norske produkter med unik kvalitet, i kombinasjon med klar lokal identitet og en god historie. Fordi lokalmat er viktig for deg, er stort utvalg norske matskatter viktig for oss.\",\"organization\":\"MENY\",\"alternative_names\":null,\"type\":null,\"year_established\":null,\"about\":\"<div>Matskatt er en merkeordning fra <a href=\\\"https://kassal.app/kjeder/meny\\\">MENY</a> som omfavner lokal mat, regional mat, kortreist mat og gårdsmat under ett felles begrep. Matskatter er mat- og drikkeprodukter som utmerker seg med en ekstra god smak, unik kvalitet og en spesiell historie. Disse produktene er preget av klar lokal identitet og kommer ofte fra både små og store produsenter.<br><br></div><div>En Matskatt defineres av sin unike kvalitet, tydelig lokal identitet og en god historie. Det kan være alt fra en utmerket ost, en smakfull skinke, et nydelig syltetøy, delikat klippfisk, en renskåret lakseloin, gode pølser, gårdspresset eple eller en velsmakende potet. MENY har funnet over 4500 produkter fra rundt 450 lokale produsenter som passer inn i Matskatt-kategorien.<br><br></div><div>MENY-Lauget, som består av erfarne fagpersoner fra ulike områder som kokker, slaktere, pølsemakere og fiskehandlere, er ansvarlig for å oppdage og promotere Matskattene. De følger med på produktutviklingen i sin region og jakter kontinuerlig på nye Matskatter. Du kan se etter Matskatt-merket i MENY-butikkene og nettbutikken for å finne disse spesielle produktene.<br><br></div><div>Matskattene er viktige for kundene til MENY, og det er en del av deres innsats for å ivareta norske mattradisjoner og støtte visjonære produsenter. MENY deler også ut Matskattstipendet årlig, som gir produsenter muligheten til å utforske nye produkter, øke produksjonen eller realisere innovasjonsprosjekter. Produsentene som bidrar til mangfoldet og skaper de uunnværlige smakene i norske Matskatter blir verdsatt og anerkjent.</div>\",\"note\":null,\"icon\":{\"svg\":\"https://kassal.app/labels/svg/Matskatt.svg\",\"png\":\"https://kassal.app/labels/png/Matskatt.png\"}}]}}","dataMatches":false},"timestamp":1768999588397,"sessionId":"debug-session","runId":"run1","hypothesisId":"C"}
